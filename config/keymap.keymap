#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC        &kp Q  &kp W     &kp E     &kp R      &kp T  &kp INT3     &kp EQUAL    &kp Y  &kp U           &kp I      &kp O     &kp P      &kp BSPC
&mt LCTRL TAB  &kp A  &kp S     &kp D     &lt 4 F    &kp G  &kp RBKT     &kp BSLH     &kp H  &lt 5 J         &kp K      &kp L     &kp MINUS  &mt RCTRL ENTER
&kp LSHFT      &kp Z  &kp X     &kp C     &kp V      &kp B  &kp LS(N8)   &kp LS(N9)   &kp N  &kp M           &kp COMMA  &kp DOT   &kp UP     &kp RSHFT
&kp LCTRL      &mo 5  &kp LGUI  &kp LALT  &lt 3 DEL         &lt 1 ENTER  &lt 2 SPACE         &mt RSHFT BSPC  &kp RALT   &kp LEFT  &kp DOWN   &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5  &bt BT_SEL 0  &bt BT_CLR               &kp N6  &kp HOME  &kp UP     &kp END    &kp LBKT  &kp EQUAL
&kp CAPS   &kp F1  &kp F2  &kp F3  &kp F4    &kp F5  &bt BT_SEL 1  &trans                   &trans  &kp LEFT  &kp DOWN   &kp RIGHT  &kp SEMI  &kp SQT
&trans     &trans  &trans  &trans  &trans    &trans  &bt BT_SEL 2  &trans                   &trans  &trans    &trans     &trans     &kp FSLH  &kp INT1
&trans     &trans  &trans  &trans  &kp BSPC          &trans        &kp LANG_ZENKAKUHANKAKU          &kp BSPC  &kp K_APP  &trans     &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans     &trans     &kp ESC    &trans     &trans  &trans                   &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &kp F11
&trans  &kp LC(A)  &kp LC(S)  &trans     &trans     &trans  &trans                   &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans  &trans                   &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans     &trans     &trans     &trans             &kp LANG_ZENKAKUHANKAKU  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans     &trans     &kp ESC           &trans         &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans        &trans
&trans  &mkp LCLK  &mkp LCLK  &kp C_AC_FORWARD  &kp C_AC_BACK  &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp LS(SEMI)  &kp LS(SQT)
&trans  &trans     &trans     &trans            &trans         &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &kp FSLH      &trans
&trans  &trans     &trans     &trans            &trans                 &trans  &trans          &kp N0  &trans  &trans  &trans        &trans
            >;
        };

        layer_4 {
            bindings = <
&kp LA(F4)  &trans  &trans         &trans  &trans             &trans  &trans           &trans            &trans          &kp LS(N7)      &kp LS(N8)      &kp LS(N9)        &trans            &trans
&trans      &trans  &kp LG(LS(S))  &trans  &trans             &trans  &trans           &trans            &kp LC(LA(N0))  &kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))    &kp LC(LA(N4))    &kp LC(FSLH)
&trans      &trans  &trans         &trans  &trans             &trans  &trans           &trans            &trans          &kp KP_N1       &kp KP_N2       &kp KP_N3         &kp LC(LA(UP))    &trans
&trans      &trans  &trans         &trans  &kp LC(LS(LA(R)))          &kp LC(LS(F10))  &kp LC(LA(DOWN))                  &kp RGUI        &trans          &kp LC(LA(LEFT))  &kp LC(LA(DOWN))  &kp LC(LA(RIGHT))
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans         &trans            &trans         &trans  &trans           &trans            &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &kp LG(LS(S))  &kp C_AC_FORWARD  &kp C_AC_BACK  &trans  &trans           &trans            &kp LC(LA(N0))  &kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))  &kp LC(LA(N4))  &kp LC(FSLH)
&trans  &trans  &trans         &trans            &trans         &trans  &trans           &trans            &trans          &trans          &trans          &trans          &kp K_APP       &trans
&trans  &trans  &trans         &trans            &trans                 &kp LC(LS(F10))  &kp LC(LA(DOWN))                  &kp RGUI        &trans          &trans          &trans          &trans
            >;
        };
    };
};
